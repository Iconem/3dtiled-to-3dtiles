{
  "name": "3dtiled-to-3dtiles",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "convert": "node packages/convert/cli.js",
    "dev": "npm run dev:app",
    "dev:app": "concurrently -n viewer,docs,tiles -c cyan,yellow,magenta \"npm:dev:viewer\" \"npm:dev:docs\" \"npm:serve:tiles\"",
    "dev:viewer": "pnpm --filter 3d-tiled dev",
    "dev:docs": "pnpm --filter docs dev",
    "serve:tiles": "node packages/tile-server/server.js --port 3001",
    "serve:live": "node packages/tile-server/server.js --port 3001",
    "build": "pnpm --filter 3d-tiled build",
    "dev:legacy": "concurrently -n web,tiles -c cyan,magenta \"npm:dev:web-legacy\" \"npm:serve:tiles\"",
    "dev:web-legacy": "vite",
    "build:legacy": "vite build",
    "serve:legacy": "vite preview --port 3000"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.4.28",
    "3d-tiles-rendererjs-3dgs-plugin": "0.1.13",
    "@sparkjsdev/spark": "2.1.0",
    "cesium": "1.142.0",
    "sql.js": "^1.14.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "webgpu"
    ]
  }
}
