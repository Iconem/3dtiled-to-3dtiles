{
  "name": "3dtiled-to-3dtiles",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "convert": "node packages/convert/cli.js",
    "dev": "npm run dev:app",
    "dev:app": "concurrently -n viewer,docs,tiles -c cyan,yellow,magenta \"npm:dev:viewer\" \"npm:dev:docs\" \"npm:serve:tiles\"",
    "dev:viewer": "pnpm --filter 3d-tiled dev",
    "dev:docs": "pnpm --filter docs dev",
    "serve:tiles": "node packages/tile-server/server.js --port 3001",
    "serve:live": "node packages/tile-server/server.js --port 3001",
    "build": "pnpm --filter 3d-tiled build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "webgpu"
    ]
  }
}
