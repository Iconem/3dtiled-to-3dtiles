# Copy to .env.local (git-ignored). All optional: without them, the terrains and basemap that need them
# are unavailable. These values reach the browser, so restrict each key to your domains.
# In Docker, set GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN on the viewer container instead.

# Mapbox Satellite basemap
VITE_MAPBOX_TOKEN=
# Google 3D terrain in 3DTRjs, and the Google Photorealistic preset
VITE_GOOGLE_MAPS_API_KEY=
# Cesium World Terrain, and Google 3D in Cesium
VITE_CESIUM_ION_TOKEN=
